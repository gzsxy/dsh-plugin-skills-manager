{
  "name": "dsh-plugin-skills-manager",
  "version": "0.6.0",
  "private": true,
  "description": "DSH 技能管理台：浏览/搜索/分类全部已安装技能，英文简介中文翻译，查看依赖与目录结构，一键复制调用提示词。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}